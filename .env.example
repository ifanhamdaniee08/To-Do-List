# Flask & JWT Security Keys
SECRET_KEY=your_super_secret_production_key_here
JWT_SECRET_KEY=your_jwt_secret_key_production_here

# PostgreSQL Database Connection URL
# Local Docker Compose: postgresql://postgres:postgrespassword@db:5432/todolist_db
# Cloud (Render/Neon/Supabase): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/todolist_db

# Google OAuth (Opsional - biarkan kosong jika belum dipakai)
GOOGLE_CLIENT_ID=
