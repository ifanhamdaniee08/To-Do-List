# Konfigurasi Aplikasi Flask
FLASK_APP=run.py
FLASK_ENV=development

# Kunci Enkripsi Rahasia (bisa string acak bebas)
SECRET_KEY=kunci_rahasia_flask_bebas_diisi_apa_saja_12345
JWT_SECRET_KEY=kunci_rahasia_jwt_bebas_diisi_apa_saja_67890

# Koneksi Database PostgreSQL
# Format: postgresql://<username>:<password>@<host>:<port>/<nama_database>
# Contoh: Jika PostgreSQL Anda berjalan di port 5432:
DATABASE_URL=postgresql://postgres:password_anda@localhost:5432/todolist_db
# Atau jika berjalan di port 5433:
# DATABASE_URL=postgresql://postgres:password_anda@localhost:5433/todolist_db

# Google OAuth Client ID (opsional untuk tahap awal, didapat dari Google Cloud Console)
GOOGLE_CLIENT_ID=masukkan_client_id_google_anda_disini.apps.googleusercontent.com
